# LaunchLens Backend Configuration
# Copy this file to .env and fill in your values

# Database — REQUIRED (no silent fallback)
# PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchlens
# SQLite (for local dev only):
# DATABASE_URL=sqlite:///./launchlens.db

# Redis — optional, graceful degradation when unavailable
REDIS_URL=redis://localhost:6379/0

# n8n Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/launchlens-research
N8N_CALLBACK_SECRET=change-me-to-a-strong-secret

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
